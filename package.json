{
  "name": "formularios-inteligentes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend:dev": "node --env-file=backend/.env --watch backend/src/server.mjs",
    "backend:start": "node --env-file=backend/.env backend/src/server.mjs",
    "backend:check": "node --check backend/src/server.mjs && node --check backend/src/dashboard-metrics.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "supabase": "^2.115.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
